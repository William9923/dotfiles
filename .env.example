# Example environment variables for dotfiles setup
# Copy this to zsh/.zsh_secrets and fill in your actual values

# Cachix authentication token
export CACHIX_AUTH_TOKEN="your-cachix-token-here"

# OpenCode API Keys
export REF_API_KEY="your-ref-api-key-here"

# GitHub Copilot Configuration
export GITHUB_USER="your-github-username"
export GITHUB_APP_ID="your-github-app-id"
export GITHUB_COPILOT_TOKEN="your-github-copilot-token-here"

# Add other secrets as needed...
# export OTHER_API_KEY="your-other-key-here"